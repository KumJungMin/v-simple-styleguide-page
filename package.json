{
  "name": "v-simple-styleguide-monorepo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18.20.8",
    "npm": ">=9.8.1",
    "pnpm": ">=9.0.0 <10"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
